---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="Septic Blog" description="Practical advice for Niagara Falls and Wilson homeowners on septic care, pumping, and when to call a pro.">
	<section class="page-hero">
		<div class="container">
			<h1>Septic Care Blog</h1>
			<p>Practical advice for local homeowners on septic maintenance, warning signs, and seasonal care.</p>
		</div>
	</section>
	<section class="content-block">
		<div class="container">
			<div class="blog-list">
				{posts.map((post) => (
					<article class="blog-item">
						<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
						<p class="meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
						<p>{post.data.description}</p>
						<a href={`/blog/${post.id}/`} class="more">Read more →</a>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>
